# Non-secret settings of the Control Plane backend. Every value here is a documented default or an
# unmistakable placeholder. The application does not read this file: export the values in your shell
# (for example `set -a; . ./.env.example; set +a`) or inject them from your runtime. Keep local copies
# with real values outside tracked files. No secret, credential or connection URL belongs here.
KRITVA_HTTP_PORT=8080
# Optional. Default 127.0.0.1 (loopback). Set 0.0.0.0 or :: only to listen on every interface on purpose.
#KRITVA_HTTP_HOST=127.0.0.1
# Optional. Milliseconds to wait for in-flight requests on shutdown. Default 10000, range 0-300000.
#KRITVA_HTTP_SHUTDOWN_GRACE_MS=10000
# Optional. Maximum request body in bytes. Default 1048576, range 1-104857600.
#KRITVA_HTTP_BODY_LIMIT_BYTES=1048576
